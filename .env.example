# Clerk Authentication (Required)
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration (Required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sundai_db?schema=public"

# Environment
NODE_ENV=development

# Amazon Bedrock text generation for AI images, project sharing, and news
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here

# Google Cloud Storage (Optional - for image uploads)
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here
GOOGLE_CLOUD_BUCKET=your_bucket_name_here
GOOGLE_CLOUD_CREDENTIALS=path_to_your_credentials.json 

# Private Google Cloud Storage bucket for event materials. Keep objects private;
# material access is provided only through short-lived signed URLs.
GOOGLE_CLOUD_MATERIALS_BUCKET=your_private_materials_bucket_name_here

# Event decision notifications (Optional)
NEXT_PUBLIC_APP_URL=https://www.sundai.club

# AWS region for Amazon Bedrock and SES. AWS credentials for SES use the
# standard SDK credential provider chain.
AWS_REGION=us-east-2
AWS_SES_FROM_EMAIL="Sundai Team <team@sundai.club>"

# Twilio SMS. The Messaging Service must have an SMS-capable sender assigned.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public origin that Twilio uses for request signatures and status callbacks.
TWILIO_WEBHOOK_BASE_URL=https://www.sundai.club

# Approved SMS consent language and its version. Change the version whenever the
# consent copy changes so previously captured consent is not silently reused.
NEXT_PUBLIC_SMS_CONSENT_VERSION=2026-08-04
NEXT_PUBLIC_SMS_CONSENT_COPY="I agree to receive recurring automated text messages from Sundai about event applications and updates. Message frequency varies. Message and data rates may apply. Reply STOP to unsubscribe or HELP for help. Consent is optional and is not a condition of registration."
