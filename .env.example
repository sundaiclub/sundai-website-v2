# Clerk Authentication (Required)
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
WEBHOOK_SECRET=your_webhook_secret_here

# Database Configuration (Required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sundai_db?schema=public"

# Environment
NODE_ENV=development

# LLM Key for share button
GEMINI_API_KEY=llm_api_key_here

# Google Cloud Storage (Optional - for image uploads)
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here
GOOGLE_CLOUD_BUCKET=your_bucket_name_here
GOOGLE_CLOUD_CREDENTIALS=path_to_your_credentials.json 

# Event decision notifications (Optional)
NEXT_PUBLIC_APP_URL=https://www.sundai.club

# AWS SES email. AWS credentials use the standard SDK credential provider chain.
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL="Sundai Events <events@sundai.club>"

# Twilio SMS. The Messaging Service must have an SMS-capable sender assigned.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
