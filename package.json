{
  "name": "connors-repo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "node --no-deprecation node_modules/.bin/next dev -p 3001",
    "build": "node --no-deprecation node_modules/.bin/next build",
    "check:cycles": "madge --circular --extensions ts,tsx,js,mjs --ts-config tsconfig.json src tests prisma/seed.ts jest.config.js jest.setup.js next.config.mjs next-sitemap.config.js postcss.config.mjs",
    "postbuild": "next-sitemap",
    "start": "node --no-deprecation node_modules/.bin/next start",
    "lint": "eslint .",
    "test": "node --no-deprecation node_modules/.bin/jest",
    "test:watch": "node --no-deprecation node_modules/.bin/jest --watch",
    "test:coverage": "node --no-deprecation node_modules/.bin/jest --coverage",
    "test:ci": "node --no-deprecation node_modules/.bin/jest --ci --coverage --watchAll=false",
    "setup-husky": "./scripts/setup-husky.sh",
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && ./scripts/migrate_deploy.sh && node --no-deprecation node_modules/.bin/next build && next-sitemap",
    "db:backup": "./scripts/backup_db.sh",
    "db:export:projects": "./scripts/export_projects_csv.sh",
    "db:restore": "./scripts/restore_db.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "prisma migrate reset --force",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "./scripts/migrate_deploy.sh",
    "db:backfill:sundai-boston": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' prisma/data-migrations/20260807000000_backfill_sundai_boston_events.ts",
    "fetch:sundai-boston-images": "node scripts/fetch-sundai-boston-event-images.mjs",
    "db:populate": "./scripts/populate_db.sh"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1084.0",
    "@clerk/nextjs": "7.7.6",
    "@google-cloud/storage": "8.0.0",
    "@google/genai": "^1.25.0",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.1.5",
    "@prisma/client": "^5.21.1",
    "@vercel/analytics": "^1.5.0",
    "date-fns": "^4.1.0",
    "framer-motion": "11.18.2",
    "next": "16.3.1",
    "posthog-js": "^1.225.0",
    "prisma": "^5.21.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "replicate": "^1.1.0",
    "svix": "^1.37.0",
    "twilio": "^6.0.2",
    "typewriter-effect": "2.22.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "^29.5.8",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.0",
    "madge": "^8.0.0",
    "next-sitemap": "^4.2.3",
    "postcss": "8.5.23",
    "prettier": "^3.1.0",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "jest --bail --findRelatedTests"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && npm run build"
    }
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "uuid": "11.1.1"
  }
}
