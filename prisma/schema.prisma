// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hacker {
  id          String    @id @default(uuid())
  clerkId     String    @unique
  name        String
  username    String?
  role        Role?
  bio         String?
  githubUrl   String?
  discordName String?
  twitterUrl  String?
  linkedinUrl String?
  websiteUrl  String?
  email       String?
  phoneNumber String?
  attended    Int       @default(0)
  avatar      Image?    @relation("HackerAvatar", fields: [avatarId], references: [id])
  avatarId    String?   @unique
  featuredProjectIds String[] @default([])
  projects    ProjectToParticipant[]
  ledProjects Project[] @relation("LaunchLead")
  images      Image[]   @relation("HackerImages")
  likes       ProjectLike[]
  pitchVotes  EventProjectVote[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  attendanceRecords    Attendance[]
  verifiedAttendances  Attendance[] @relation("AttendanceVerifications")
  totalMinutesAttended Int          @default(0)
  lastAttendance      DateTime?

  // Event relations
  createdEvents             Event[]
  chapterMemberships        ChapterMembership[] @relation("ChapterMembershipHacker")
  invitedChapterMemberships ChapterMembership[] @relation("ChapterMembershipInviter")
  eventStaffAssignments     EventStaff[]
  addedEventProjects        EventProject[]
  applicationTemplates      ApplicationTemplate[] @relation("ApplicationTemplateCreator")
  eventRegistrations        EventRegistration[] @relation("EventRegistrationHacker")
  decidedRegistrations      EventRegistration[] @relation("EventRegistrationDecider")
  registrationAudits        EventRegistrationAudit[] @relation("RegistrationAuditActor")
  createdUserBans           UserBan[] @relation("UserBanCreator")
  revokedUserBans           UserBan[] @relation("UserBanRevoker")
  userBans                  UserBan[] @relation("UserBanHacker")
  createdBanFlags           UserBanFlag[] @relation("UserBanFlagCreator")
  resolvedBanFlags          UserBanFlag[] @relation("UserBanFlagResolver")
  banFlags                  UserBanFlag[] @relation("UserBanFlagHacker")
  organizerNote             HackerOrganizerNote? @relation("OrganizerNoteHacker")
  updatedOrganizerNotes     HackerOrganizerNote[] @relation("OrganizerNoteUpdater")
  organizerNoteRevisions    HackerOrganizerNoteRevision[] @relation("OrganizerNoteRevisionHacker")
  editedOrganizerRevisions  HackerOrganizerNoteRevision[] @relation("OrganizerNoteRevisionEditor")

  @@index([clerkId])
}

model TechTag {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[] @relation("ProjectTechnologies")

  @@index([name])
}

model DomainTag {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[] @relation("ProjectDomains")

  @@index([name])
}

model Project {
  id          String    @id @default(uuid())
  title       String
  preview     String?    @db.VarChar(120)
  description String?
  githubUrl   String?
  demoUrl     String?
  blogUrl     String?
  thumbnail   Image?    @relation("ProjectThumbnail", fields: [thumbnailId], references: [id])
  thumbnailId String?   @unique
  launchLead  Hacker    @relation("LaunchLead", fields: [launchLeadId], references: [id])
  launchLeadId String
  participants ProjectToParticipant[]
  images      Image[]   @relation("ProjectImages")
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      ProjectStatus @default(PENDING)
  hack_type   HackType? @default(REGULAR)
  likes       ProjectLike[]
  weeks       Week[]    // Many-to-many as projects can span multiple weeks
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  is_starred  Boolean   @default(false)
  is_broken   Boolean   @default(false)
  techTags    TechTag[] @relation("ProjectTechnologies")
  domainTags  DomainTag[] @relation("ProjectDomains")

  @@index([launchLeadId])
  attendance Attendance[]
  // Pitch queue entries linking this project to events
  eventEntries EventProject[]
}

model ProjectToParticipant {
  id        String   @id @default(uuid())
  hacker    Hacker   @relation(fields: [hackerId], references: [id])
  hackerId  String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([hackerId, projectId])
}

model Image {
  id              String    @id @default(uuid())
  key             String    @unique // S3 object key
  bucket          String    // S3 bucket name
  url             String    // Full S3 URL
  filename        String    // Original filename
  mimeType        String    // File MIME type
  size            Int       // File size in bytes
  width           Int?      // Image width in pixels
  height          Int?      // Image height in pixels
  alt             String?   // Alt text for accessibility
  prompt          String?   // Prompt used to generate the image when applicable
  
  // Relations
  hackerAvatar    Hacker?   @relation("HackerAvatar")
  hackerImages    Hacker?   @relation("HackerImages", fields: [hackerId], references: [id])
  hackerId        String?
  
  projectThumbnail Project? @relation("ProjectThumbnail")
  projectImages    Project? @relation("ProjectImages", fields: [projectId], references: [id])
  projectId        String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([key])
  @@index([hackerId])
  @@index([projectId])
}

model ProjectLike {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  hacker    Hacker   @relation(fields: [hackerId], references: [id])
  hackerId  String
  createdAt DateTime @default(now())

  @@unique([projectId, hackerId])
  @@index([projectId])
  @@index([hackerId])
}

model Attendance {
  id        String          @id @default(cuid())
  hacker    Hacker         @relation(fields: [hackerId], references: [id])
  hackerId  String
  verifiedBy Hacker?       @relation("AttendanceVerifications", fields: [verifierId], references: [id])
  verifierId String?
  week      Week           @relation(fields: [weekId], references: [id])
  weekId    String
  project   Project?       @relation(fields: [projectId], references: [id])
  projectId String?
  status    AttendanceStatus @default(PRESENT)
  timestamp DateTime       @default(now())

  @@unique([hackerId, weekId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model Week {
  id          String    @id @default(uuid())
  number      Int       // Week number (1, 2, 3, etc.)
  startDate   DateTime
  endDate     DateTime
  theme       String?   // Optional theme for the week
  description String?
  projects    Project[] // Projects started this week
  attendance  Attendance[] // Attendance records for this week
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([number])
  @@index([startDate, endDate])
}

enum Role {
  NOT_SET
  NEWBIE
  HACKER
  SPONSOR
  LEADER
  SITE_ADMIN
}

enum ChapterStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ChapterAccessMode {
  PUBLIC
  PRIVATE
}

enum ChapterMembershipRole {
  MEMBER
  ADMIN
}

enum ChapterMembershipStatus {
  INVITED
  ACTIVE
  REVOKED
  LEFT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum EventApplicationMode {
  NONE
  INTERNAL
  PUBLIC_LATER
}

enum EventStaffRole {
  MC
  CO_MC
}

enum ApplicationTemplateScope {
  SITE
  CHAPTER
}

enum EventRegistrationStatus {
  PENDING
  APPROVED
  WAITLISTED
  DECLINED
  BLOCKED
  CANCELLED
}

enum EventRegistrationSource {
  INTERNAL
  PUBLIC_LATER
  IMPORT
}

enum BanFlagStatus {
  OPEN
  REVIEWING
  RESOLVED_NO_ACTION
  RESOLVED_BANNED
  DISMISSED
}

enum ProjectStatus {
  DRAFT
  PENDING
  APPROVED
}

enum HackType {
  REGULAR
  RESEARCH
}

enum EventPhase {
  VOTING
  PITCHING
  FINISHED
}

// Events and Pitch Queue
model Event {
  id               String     @id @default(uuid())
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime?
  meetingUrl       String?
  location         String?
  venueName        String?
  publicLocation   String?
  address          String?
  virtualUrl       String?
  createdBy        Hacker     @relation(fields: [createdById], references: [id])
  createdById      String
  chapter          Chapter    @relation(fields: [chapterId], references: [id])
  chapterId        String
  slug             String
  slugNeedsCleanup Boolean    @default(false)
  status           EventStatus @default(DRAFT)
  visibility       EventVisibility @default(PUBLIC)
  programType      String?
  publicProgramLabel String?
  capacity         Int?
  applicationMode  EventApplicationMode @default(NONE)
  autoPromoteWaitlist Boolean @default(false)
  approvedDetailsJson Json?
  applicationQuestionsJson Json?
  hideChapterDefaultQuestions Boolean @default(false)
  applicationsOpen DateTime?
  applicationsCloseReason String?
  checkInOpensAt   DateTime?
  checkInClosesAt  DateTime?
  audienceCanReorder Boolean  @default(true)
  votingEndTime    DateTime?
  phase            EventPhase @default(VOTING)
  topProjectCount      Int    @default(5)
  topPresentingSec     Int    @default(120)
  topQuestionsSec      Int    @default(180)
  defaultPresentingSec Int    @default(60)
  defaultQuestionsSec  Int    @default(120)
  projects         EventProject[]
  staff            EventStaff[]
  registrations    EventRegistration[]
  registrationAudits EventRegistrationAudit[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([chapterId, slug])
  @@index([startTime])
  @@index([chapterId, status, startTime])
  @@index([visibility, status])
}

model Chapter {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  city                  String
  region                String?
  country               String
  timezone              String
  description           String?
  status                ChapterStatus         @default(ACTIVE)
  accessMode            ChapterAccessMode     @default(PUBLIC)
  defaultDeclineMessage String?
  mailingListName       String?
  mailingListExternalId String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  memberships           ChapterMembership[]
  events                Event[]
  applicationTemplates  ApplicationTemplate[]
  banFlags              UserBanFlag[]

  @@index([status, accessMode])
  @@index([slug])
}

model ChapterMembership {
  id                           String                  @id @default(uuid())
  chapter                      Chapter                 @relation(fields: [chapterId], references: [id])
  chapterId                    String
  hacker                       Hacker                  @relation("ChapterMembershipHacker", fields: [hackerId], references: [id])
  hackerId                     String
  role                         ChapterMembershipRole   @default(MEMBER)
  status                       ChapterMembershipStatus @default(INVITED)
  invitedBy                    Hacker?                 @relation("ChapterMembershipInviter", fields: [invitedById], references: [id])
  invitedById                  String?
  invitedAt                    DateTime?
  joinedAt                     DateTime?
  leftAt                       DateTime?
  revokedAt                    DateTime?
  notificationsAllowed         Boolean                 @default(false)
  emailNotificationsEnabled    Boolean                 @default(false)
  smsNotificationsEnabled      Boolean                 @default(false)
  notificationPreferencesJson  Json?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  @@unique([chapterId, hackerId])
  @@index([hackerId, status])
  @@index([chapterId, role, status])
}

model EventStaff {
  id        String         @id @default(uuid())
  event     Event          @relation(fields: [eventId], references: [id])
  eventId   String
  hacker    Hacker         @relation(fields: [hackerId], references: [id])
  hackerId  String
  role      EventStaffRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([eventId, hackerId, role])
  @@index([eventId, role])
  @@index([hackerId])
}

model ApplicationTemplate {
  id          String                   @id @default(uuid())
  scope       ApplicationTemplateScope
  chapter     Chapter?                 @relation(fields: [chapterId], references: [id])
  chapterId   String?
  name        String
  fieldsJson  Json
  isActive    Boolean                  @default(true)
  createdBy   Hacker                   @relation("ApplicationTemplateCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([scope, isActive])
  @@index([chapterId, isActive])
}

model EventRegistration {
  id                   String                  @id @default(uuid())
  event                Event                   @relation(fields: [eventId], references: [id])
  eventId              String
  hacker               Hacker                  @relation("EventRegistrationHacker", fields: [hackerId], references: [id])
  hackerId             String
  status               EventRegistrationStatus @default(PENDING)
  source               EventRegistrationSource @default(INTERNAL)
  answersJson          Json?
  templateSnapshotJson Json?
  publicSafeMessage    String?
  internalReviewNotes  String?
  decidedBy            Hacker?                 @relation("EventRegistrationDecider", fields: [decidedById], references: [id])
  decidedById          String?
  decidedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  audits               EventRegistrationAudit[]

  @@unique([eventId, hackerId])
  @@index([eventId, status])
  @@index([hackerId, status])
}

model EventRegistrationAudit {
  id             String                   @id @default(uuid())
  registration   EventRegistration        @relation(fields: [registrationId], references: [id])
  registrationId String
  event          Event                    @relation(fields: [eventId], references: [id])
  eventId        String
  actor          Hacker                   @relation("RegistrationAuditActor", fields: [actorId], references: [id])
  actorId        String
  fromStatus     EventRegistrationStatus?
  toStatus       EventRegistrationStatus
  changeJson     Json?
  createdAt      DateTime                 @default(now())

  @@index([registrationId, createdAt])
  @@index([eventId, createdAt])
  @@index([actorId])
}

model UserBan {
  id                String    @id @default(uuid())
  hacker            Hacker    @relation("UserBanHacker", fields: [hackerId], references: [id])
  hackerId          String
  publicSafeReason  String
  internalNote      String?
  createdBy         Hacker    @relation("UserBanCreator", fields: [createdById], references: [id])
  createdById       String
  createdAt         DateTime  @default(now())
  revokedBy         Hacker?   @relation("UserBanRevoker", fields: [revokedById], references: [id])
  revokedById       String?
  revokedAt         DateTime?
  revocationReason  String?

  @@index([hackerId, revokedAt])
  @@index([createdById])
}

model UserBanFlag {
  id             String        @id @default(uuid())
  chapter        Chapter       @relation(fields: [chapterId], references: [id])
  chapterId      String
  hacker         Hacker        @relation("UserBanFlagHacker", fields: [hackerId], references: [id])
  hackerId       String
  createdBy      Hacker        @relation("UserBanFlagCreator", fields: [createdById], references: [id])
  createdById    String
  reason         String
  status         BanFlagStatus @default(OPEN)
  resolutionNote String?
  resolvedBy     Hacker?       @relation("UserBanFlagResolver", fields: [resolvedById], references: [id])
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([chapterId, status])
  @@index([hackerId, status])
  @@index([createdById])
}

model HackerOrganizerNote {
  id          String                         @id @default(uuid())
  hacker      Hacker                         @relation("OrganizerNoteHacker", fields: [hackerId], references: [id])
  hackerId    String                         @unique
  body        String
  updatedBy   Hacker                         @relation("OrganizerNoteUpdater", fields: [updatedById], references: [id])
  updatedById String
  createdAt   DateTime                       @default(now())
  updatedAt   DateTime                       @updatedAt
  revisions   HackerOrganizerNoteRevision[]

  @@index([updatedById])
}

model HackerOrganizerNoteRevision {
  id         String              @id @default(uuid())
  note       HackerOrganizerNote @relation(fields: [noteId], references: [id])
  noteId     String
  hacker     Hacker              @relation("OrganizerNoteRevisionHacker", fields: [hackerId], references: [id])
  hackerId   String
  editedBy   Hacker              @relation("OrganizerNoteRevisionEditor", fields: [editedById], references: [id])
  editedById String
  patchText  String
  createdAt  DateTime            @default(now())

  @@index([noteId, createdAt])
  @@index([hackerId, createdAt])
  @@index([editedById])
}

model EventProject {
  id         String             @id @default(uuid())
  event      Event              @relation(fields: [eventId], references: [id])
  eventId    String
  project    Project            @relation(fields: [projectId], references: [id])
  projectId  String
  addedBy    Hacker             @relation(fields: [addedById], references: [id])
  addedById  String
  position   Int                @default(0)
  status     EventProjectStatus @default(QUEUED)
  approved   Boolean            @default(false)
  isTopProject Boolean          @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // Timer fields
  pitchPhase            PitchPhase @default(WAITING)
  presentingStartedAt   DateTime?
  questionsStartedAt    DateTime?
  completedAt           DateTime?
  pausedAt              DateTime?
  allottedPresentingSec Int?
  allottedQuestionsSec  Int?
  pitchVotes            EventProjectVote[]

  @@unique([eventId, projectId])
  @@index([eventId, position])
  @@index([status])
}

model EventProjectVote {
  id             String       @id @default(uuid())
  eventProject   EventProject @relation(fields: [eventProjectId], references: [id])
  eventProjectId String
  hacker         Hacker       @relation(fields: [hackerId], references: [id])
  hackerId       String
  value          EventProjectVoteValue
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([eventProjectId, hackerId])
  @@index([eventProjectId])
  @@index([hackerId])
}

enum EventProjectVoteValue {
  LIKE
  DISLIKE
}

enum EventProjectStatus {
  QUEUED
  APPROVED
  CURRENT
  DONE
  SKIPPED
}

enum PitchPhase {
  WAITING
  PRESENTING
  QUESTIONS
  COMPLETED
}
