// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Hacker {
  id                   String                 @id @default(uuid())
  clerkId              String?                @unique
  name                 String
  username             String?
  role                 Role?
  bio                  String?
  githubUrl            String?
  discordName          String?
  twitterUrl           String?
  linkedinUrl          String?
  websiteUrl           String?
  email                String?
  phoneNumber          String?
  smsConsentAt         DateTime?
  smsConsentVersion    String?
  attended             Int                    @default(0)
  avatar               Image?                 @relation("HackerAvatar", fields: [avatarId], references: [id])
  avatarId             String?                @unique
  featuredProjectIds   String[]               @default([])
  projects             ProjectToParticipant[]
  ledProjects          Project[]              @relation("LaunchLead")
  images               Image[]                @relation("HackerImages")
  likes                ProjectLike[]
  pitchVotes           PitchProjectVote[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  attendanceRecords    Attendance[]
  verifiedAttendances  Attendance[]           @relation("AttendanceVerifications")
  totalMinutesAttended Int                    @default(0)
  lastAttendance       DateTime?

  // Event relations
  createdEvents             Event[]
  createdPitchSessions      PitchSession[]
  chapterMemberships        ChapterMembership[]           @relation("ChapterMembershipHacker")
  invitedChapterMemberships ChapterMembership[]           @relation("ChapterMembershipInviter")
  eventStaffAssignments     EventStaff[]
  addedPitchProjects        PitchProject[]
  addedEventProjects        EventProject[]                @relation("EventProjectAdder")
  applicationTemplates      ApplicationTemplate[]         @relation("ApplicationTemplateCreator")
  eventRegistrations        EventRegistration[]           @relation("EventRegistrationHacker")
  decidedRegistrations      EventRegistration[]           @relation("EventRegistrationDecider")
  cancelledRegistrations    EventRegistration[]           @relation("EventRegistrationCanceller")
  checkedInRegistrations    EventRegistration[]           @relation("EventRegistrationCheckIn")
  applicationsClosedEvents  Event[]                       @relation("EventApplicationsClosedBy")
  registrationAudits        EventRegistrationAudit[]      @relation("RegistrationAuditActor")
  createdUserBans           UserBan[]                     @relation("UserBanCreator")
  revokedUserBans           UserBan[]                     @relation("UserBanRevoker")
  userBans                  UserBan[]                     @relation("UserBanHacker")
  createdBanFlags           UserBanFlag[]                 @relation("UserBanFlagCreator")
  resolvedBanFlags          UserBanFlag[]                 @relation("UserBanFlagResolver")
  banFlags                  UserBanFlag[]                 @relation("UserBanFlagHacker")
  organizerNote             HackerOrganizerNote?          @relation("OrganizerNoteHacker")
  updatedOrganizerNotes     HackerOrganizerNote[]         @relation("OrganizerNoteUpdater")
  organizerNoteRevisions    HackerOrganizerNoteRevision[] @relation("OrganizerNoteRevisionHacker")
  editedOrganizerRevisions  HackerOrganizerNoteRevision[] @relation("OrganizerNoteRevisionEditor")
  createdEventMaterials     EventMaterial[]               @relation("EventMaterialCreator")
  eventMaterialAudits       EventMaterialAudit[]          @relation("EventMaterialAuditActor")
  createdCommunications     EventCommunication[]          @relation("EventCommunicationCreator")
  sentCommunications        EventCommunication[]          @relation("EventCommunicationSender")
  communicationRecipients   EventCommunicationRecipient[] @relation("EventCommunicationRecipientHacker")
  smsPreferenceEvents       SmsPreferenceEvent[]          @relation("SmsPreferenceEventHacker")
  staffAuditSubjects        EventStaffAudit[]             @relation("EventStaffAuditSubject")
  staffAuditActions         EventStaffAudit[]             @relation("EventStaffAuditActor")
  judgeAssignments          EventJudge[]                  @relation("EventJudgeHacker")
  invitedJudges             EventJudge[]                  @relation("EventJudgeInviter")
  judgingSubmissions        JudgingSubmission[]           @relation("JudgingSubmissionSubmitter")

  @@index([clerkId])
}

model TechTag {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[] @relation("ProjectTechnologies")

  @@index([name])
}

model DomainTag {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[] @relation("ProjectDomains")

  @@index([name])
}

model Project {
  id                  String                 @id @default(uuid())
  title               String
  preview             String?                @db.VarChar(120)
  description         String?
  githubUrl           String?
  demoUrl             String?
  blogUrl             String?
  thumbnail           Image?                 @relation("ProjectThumbnail", fields: [thumbnailId], references: [id])
  thumbnailId         String?                @unique
  launchLead          Hacker                 @relation("LaunchLead", fields: [launchLeadId], references: [id])
  launchLeadId        String
  participants        ProjectToParticipant[]
  images              Image[]                @relation("ProjectImages")
  startDate           DateTime               @default(now())
  endDate             DateTime?
  status              ProjectStatus          @default(PENDING)
  hack_type           HackType?              @default(REGULAR)
  likes               ProjectLike[]
  weeks               Week[] // Many-to-many as projects can span multiple weeks
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  is_starred          Boolean                @default(false)
  is_broken           Boolean                @default(false)
  techTags            TechTag[]              @relation("ProjectTechnologies")
  domainTags          DomainTag[]            @relation("ProjectDomains")
  attendance          Attendance[]
  // Pitch queue entries linking this project to events
  pitchEntries        PitchProject[]
  eventParticipations EventProject[]
  judgingSubmissions  JudgingSubmission[]

  @@index([launchLeadId])
}

model ProjectToParticipant {
  id        String   @id @default(uuid())
  hacker    Hacker   @relation(fields: [hackerId], references: [id])
  hackerId  String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  role      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hackerId, projectId])
}

model Image {
  id       String  @id @default(uuid())
  key      String  @unique // S3 object key
  bucket   String // S3 bucket name
  url      String // Full S3 URL
  filename String // Original filename
  mimeType String // File MIME type
  size     Int // File size in bytes
  width    Int? // Image width in pixels
  height   Int? // Image height in pixels
  alt      String? // Alt text for accessibility
  prompt   String? // Prompt used to generate the image when applicable

  // Relations
  hackerAvatar Hacker? @relation("HackerAvatar")
  hackerImages Hacker? @relation("HackerImages", fields: [hackerId], references: [id])
  hackerId     String?

  projectThumbnail Project? @relation("ProjectThumbnail")
  projectImages    Project? @relation("ProjectImages", fields: [projectId], references: [id])
  projectId        String?
  chapterHeroImage Chapter? @relation("ChapterHeroImage")
  eventImage       Event?   @relation("EventImage")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([hackerId])
  @@index([projectId])
}

model ProjectLike {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  hacker    Hacker   @relation(fields: [hackerId], references: [id])
  hackerId  String
  createdAt DateTime @default(now())

  @@unique([projectId, hackerId])
  @@index([projectId])
  @@index([hackerId])
}

model Attendance {
  id         String           @id @default(cuid())
  hacker     Hacker           @relation(fields: [hackerId], references: [id])
  hackerId   String
  verifiedBy Hacker?          @relation("AttendanceVerifications", fields: [verifierId], references: [id])
  verifierId String?
  week       Week             @relation(fields: [weekId], references: [id])
  weekId     String
  project    Project?         @relation(fields: [projectId], references: [id])
  projectId  String?
  status     AttendanceStatus @default(PRESENT)
  timestamp  DateTime         @default(now())

  @@unique([hackerId, weekId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

model Week {
  id          String       @id @default(uuid())
  number      Int // Week number (1, 2, 3, etc.)
  startDate   DateTime
  endDate     DateTime
  theme       String? // Optional theme for the week
  description String?
  projects    Project[] // Projects started this week
  attendance  Attendance[] // Attendance records for this week
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([number])
  @@index([startDate, endDate])
}

enum Role {
  NOT_SET
  NEWBIE
  HACKER
  SPONSOR
  LEADER
  SITE_ADMIN
}

enum ChapterStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ChapterAccessMode {
  PUBLIC
  PRIVATE
}

enum ChapterMembershipRole {
  MEMBER
  ADMIN
}

enum ChapterMembershipStatus {
  INVITED
  ACTIVE
  REVOKED
  LEFT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum EventApplicationMode {
  REQUIRES_APPROVAL
  OPEN_RSVP
}

enum EventStaffRole {
  MC
  CO_MC
}

enum EventMaterialKind {
  LINK
  FILE
}

enum EventMaterialVisibility {
  PUBLIC
  APPROVED_ATTENDEES
  ORGANIZERS_ONLY
}

enum EventMaterialAuditAction {
  CREATED
  UPDATED
  REORDERED
  REMOVED
}

enum EventCommunicationChannel {
  EMAIL
  SMS
}

enum EventCommunicationStatus {
  DRAFT
  SENDING
  SENT
  PARTIAL
  FAILED
}

enum EventCommunicationAudience {
  ACTIVE_REGISTERED
  CHAPTER_MEMBERS
  PENDING
  APPROVED
  WAITLISTED
  DECLINED
  SELECTED
}

enum EventCommunicationRecipientStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  UNDELIVERED
  FAILED
}

enum SmsPreferenceEventType {
  STOP
  HELP
  START
}

enum EventStaffAuditAction {
  ASSIGNED
  ROLE_CHANGED
  REMOVED
}

enum EventProjectCardStatus {
  DRAFT
  NEEDS_INFO
  SUBMITTED
  APPROVED
}

enum ApplicationTemplateScope {
  SITE
  CHAPTER
}

enum EventRegistrationStatus {
  PENDING
  APPROVED
  WAITLISTED
  DECLINED
  BLOCKED
  CANCELLED
}

enum EventRegistrationSource {
  INTERNAL
  WEBSITE
  IMPORT
}

enum BanFlagStatus {
  OPEN
  REVIEWING
  RESOLVED_NO_ACTION
  RESOLVED_BANNED
  DISMISSED
}

enum ProjectStatus {
  DRAFT
  PENDING
  APPROVED
}

enum HackType {
  REGULAR
  RESEARCH
}

enum PitchSessionPhase {
  VOTING
  PITCHING
  FINISHED
}

// Events and Pitch Queue
model Event {
  id                          String                   @id @default(uuid())
  title                       String
  description                 String?
  startTime                   DateTime
  endTime                     DateTime?
  timezone                    String
  meetingUrl                  String?
  location                    String?
  venueName                   String?
  publicLocation              String?
  address                     String?
  virtualUrl                  String?
  createdBy                   Hacker                   @relation(fields: [createdById], references: [id])
  createdById                 String
  chapter                     Chapter                  @relation(fields: [chapterId], references: [id])
  chapterId                   String
  slug                        String
  status                      EventStatus              @default(DRAFT)
  visibility                  EventVisibility          @default(PUBLIC)
  programType                 String?
  publicProgramLabel          String?
  capacity                    Int?
  applicationMode             EventApplicationMode     @default(REQUIRES_APPROVAL)
  applicationRequired         Boolean                  @default(true)
  requireGithubUrl            Boolean                  @default(false)
  autoPromoteWaitlist         Boolean                  @default(false)
  approvedDetailsJson         Json?
  applicationQuestionsJson    Json?
  communicationLocationsJson  Json?
  hideChapterDefaultQuestions Boolean                  @default(false)
  confirmationMessage         String?
  waitlistMessage             String?
  declineMessage              String?
  applicationsOpen            Boolean                  @default(true)
  applicationsClosedAt        DateTime?
  applicationsClosedBy        Hacker?                  @relation("EventApplicationsClosedBy", fields: [applicationsClosedById], references: [id])
  applicationsClosedById      String?
  applicationsCloseReason     String?
  trackAttendance             Boolean                  @default(false)
  // Judging: submissions default to the event window unless overridden.
  judgingEnabled              Boolean                  @default(false)
  projectsHidden              Boolean                  @default(false)
  judgingOpen                 Boolean                  @default(false)
  judgesPerProject            Int                      @default(3)
  judgingAssignmentsPublishedAt DateTime?
  judgingSubmissionsOpenAt    DateTime?
  judgingSubmissionsCloseAt   DateTime?
  image                       Image?                   @relation("EventImage", fields: [imageId], references: [id])
  imageId                     String?                  @unique
  staff                       EventStaff[]
  pitchSessions               PitchSession[]
  projects                    EventProject[]
  registrations               EventRegistration[]
  registrationAudits          EventRegistrationAudit[]
  materials                   EventMaterial[]
  materialAudits              EventMaterialAudit[]
  communications              EventCommunication[]
  staffAudits                 EventStaffAudit[]
  judgingTracks               JudgingTrack[]
  judgingCriteria             JudgingCriterion[]
  judges                      EventJudge[]
  judgingSubmissions          JudgingSubmission[]
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  @@unique([chapterId, slug])
  @@index([startTime])
  @@index([chapterId, status, startTime])
  @@index([visibility, status])
}

model EventProject {
  id         String                 @id @default(uuid())
  event      Event                  @relation(fields: [eventId], references: [id])
  eventId    String
  project    Project                @relation(fields: [projectId], references: [id])
  projectId  String
  addedBy    Hacker                 @relation("EventProjectAdder", fields: [addedById], references: [id])
  addedById  String
  cardStatus EventProjectCardStatus @default(DRAFT)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([eventId, projectId])
  @@index([eventId, cardStatus])
  @@index([projectId])
  @@index([addedById])
}

model PitchSession {
  id                 String            @id @default(uuid())
  event              Event?            @relation(fields: [eventId], references: [id])
  eventId            String?
  chapter            Chapter           @relation(fields: [chapterId], references: [id])
  chapterId          String
  legacyBackfill     Boolean           @default(false)
  title              String
  description        String?
  startTime          DateTime
  meetingUrl         String?
  location           String?
  audienceCanReorder Boolean           @default(true)
  votingEndTime      DateTime?
  phase              PitchSessionPhase @default(VOTING)
  topProjectCount    Int               @default(5)
  topPitchSec        Int               @default(300)
  defaultPitchSec    Int               @default(180)
  projects           PitchProject[]
  createdBy          Hacker            @relation(fields: [createdById], references: [id])
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([eventId])
  @@index([chapterId, startTime])
  @@index([startTime])
}

model Chapter {
  id                      String                @id @default(uuid())
  name                    String
  slug                    String                @unique
  city                    String
  region                  String?
  country                 String
  timezone                String
  description             String?
  heroImage               Image?                @relation("ChapterHeroImage", fields: [heroImageId], references: [id])
  heroImageId             String?               @unique
  status                  ChapterStatus         @default(ACTIVE)
  accessMode              ChapterAccessMode     @default(PUBLIC)
  mailingListName         String?
  mailingListExternalId   String?
  defaultApprovalMessage  String?
  defaultWaitlistMessage  String?
  defaultRejectionMessage String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  memberships             ChapterMembership[]
  events                  Event[]
  pitchSessions           PitchSession[]
  applicationTemplates    ApplicationTemplate[]
  banFlags                UserBanFlag[]

  @@index([status, accessMode])
  @@index([slug])
}

model ChapterMembership {
  id                          String                  @id @default(uuid())
  chapter                     Chapter                 @relation(fields: [chapterId], references: [id])
  chapterId                   String
  hacker                      Hacker                  @relation("ChapterMembershipHacker", fields: [hackerId], references: [id])
  hackerId                    String
  role                        ChapterMembershipRole   @default(MEMBER)
  status                      ChapterMembershipStatus @default(INVITED)
  invitedBy                   Hacker?                 @relation("ChapterMembershipInviter", fields: [invitedById], references: [id])
  invitedById                 String?
  invitedAt                   DateTime?
  joinedAt                    DateTime?
  leftAt                      DateTime?
  revokedAt                   DateTime?
  notificationsAllowed        Boolean                 @default(false)
  emailNotificationsEnabled   Boolean                 @default(false)
  smsNotificationsEnabled     Boolean                 @default(false)
  smsConsentAt                DateTime?
  smsConsentVersion           String?
  notificationPreferencesJson Json?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  @@unique([chapterId, hackerId])
  @@index([hackerId, status])
  @@index([chapterId, role, status])
}

model EventStaff {
  id        String         @id @default(uuid())
  event     Event          @relation(fields: [eventId], references: [id])
  eventId   String
  hacker    Hacker         @relation(fields: [hackerId], references: [id])
  hackerId  String
  role      EventStaffRole
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([eventId, hackerId])
  @@index([eventId, role])
  @@index([hackerId])
}

model ApplicationTemplate {
  id          String                   @id @default(uuid())
  scope       ApplicationTemplateScope
  chapter     Chapter?                 @relation(fields: [chapterId], references: [id])
  chapterId   String?
  name        String
  fieldsJson  Json
  isActive    Boolean                  @default(true)
  createdBy   Hacker                   @relation("ApplicationTemplateCreator", fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([scope, isActive])
  @@index([chapterId, isActive])
}

model EventRegistration {
  id                      String                        @id @default(uuid())
  event                   Event                         @relation(fields: [eventId], references: [id])
  eventId                 String
  hacker                  Hacker                        @relation("EventRegistrationHacker", fields: [hackerId], references: [id])
  hackerId                String
  status                  EventRegistrationStatus       @default(PENDING)
  source                  EventRegistrationSource       @default(INTERNAL)
  answersJson             Json?
  templateSnapshotJson    Json?
  publicSafeMessage       String?
  internalReviewNotes     String?
  submittedAt             DateTime                      @default(now())
  decidedBy               Hacker?                       @relation("EventRegistrationDecider", fields: [decidedById], references: [id])
  decidedById             String?
  decidedAt               DateTime?
  cancelledBy             Hacker?                       @relation("EventRegistrationCanceller", fields: [cancelledById], references: [id])
  cancelledById           String?
  cancelledAt             DateTime?
  waitlistedAt            DateTime?
  checkInToken            String                        @unique @default(uuid())
  checkedInAt             DateTime?
  checkedInBy             Hacker?                       @relation("EventRegistrationCheckIn", fields: [checkedInById], references: [id])
  checkedInById           String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  audits                  EventRegistrationAudit[]
  communicationRecipients EventCommunicationRecipient[]

  @@unique([eventId, hackerId])
  @@index([eventId, status])
  @@index([eventId, status, checkedInAt])
  @@index([eventId, status, cancelledAt])
  @@index([eventId, status, waitlistedAt])
  @@index([hackerId, status])
}

model EventRegistrationAudit {
  id             String                   @id @default(uuid())
  registration   EventRegistration        @relation(fields: [registrationId], references: [id])
  registrationId String
  event          Event                    @relation(fields: [eventId], references: [id])
  eventId        String
  actor          Hacker                   @relation("RegistrationAuditActor", fields: [actorId], references: [id])
  actorId        String
  fromStatus     EventRegistrationStatus?
  toStatus       EventRegistrationStatus
  changeJson     Json?
  createdAt      DateTime                 @default(now())

  @@index([registrationId, createdAt])
  @@index([eventId, createdAt])
  @@index([actorId])
}

model EventMaterial {
  id               String                  @id @default(uuid())
  event            Event                   @relation(fields: [eventId], references: [id])
  eventId          String
  kind             EventMaterialKind
  visibility       EventMaterialVisibility
  title            String
  description      String?
  externalUrl      String?
  objectKey        String?                 @unique
  bucket           String?
  originalFilename String?
  mimeType         String?
  size             Int?
  position         Int                     @default(0)
  isAvailable      Boolean                 @default(true)
  availableFrom    DateTime?
  availableUntil   DateTime?
  createdBy        Hacker                  @relation("EventMaterialCreator", fields: [createdById], references: [id])
  createdById      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  audits           EventMaterialAudit[]

  @@index([eventId, visibility, isAvailable, position])
}

model EventMaterialAudit {
  id         String                   @id @default(uuid())
  event      Event                    @relation(fields: [eventId], references: [id])
  eventId    String
  material   EventMaterial?           @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialId String?
  actor      Hacker                   @relation("EventMaterialAuditActor", fields: [actorId], references: [id])
  actorId    String
  action     EventMaterialAuditAction
  changeJson Json
  createdAt  DateTime                 @default(now())

  @@index([eventId, createdAt])
  @@index([materialId, createdAt])
  @@index([actorId, createdAt])
}

model EventCommunication {
  id                     String                        @id @default(uuid())
  event                  Event                         @relation(fields: [eventId], references: [id])
  eventId                String
  createdBy              Hacker                        @relation("EventCommunicationCreator", fields: [createdById], references: [id])
  createdById            String
  sentBy                 Hacker?                       @relation("EventCommunicationSender", fields: [sentById], references: [id])
  sentById               String?
  channel                EventCommunicationChannel
  status                 EventCommunicationStatus      @default(DRAFT)
  subject                String?
  body                   String
  audienceType           EventCommunicationAudience
  audienceDefinitionJson Json
  previewFingerprint     String?
  recipientCount         Int                           @default(0)
  sentCount              Int                           @default(0)
  failedCount            Int                           @default(0)
  sentAt                 DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  recipients             EventCommunicationRecipient[]
  emailBatches           EmailDeliveryBatch[]

  @@index([eventId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([createdById, createdAt])
}

model EventCommunicationRecipient {
  id                String                            @id @default(uuid())
  communication     EventCommunication                @relation(fields: [communicationId], references: [id])
  communicationId   String
  hacker            Hacker                            @relation("EventCommunicationRecipientHacker", fields: [hackerId], references: [id])
  hackerId          String
  registration      EventRegistration?                @relation(fields: [registrationId], references: [id])
  registrationId    String?
  contactValue      String
  displayName       String
  status            EventCommunicationRecipientStatus @default(PENDING)
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  attemptedAt       DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  @@unique([communicationId, hackerId])
  @@index([communicationId, status])
  @@index([providerMessageId])
  @@index([hackerId, createdAt])
  @@index([registrationId])
}

model SmsPreferenceEvent {
  id          String                 @id @default(uuid())
  providerSid String                 @unique
  type        SmsPreferenceEventType
  fromNumber  String
  toNumber    String?
  hacker      Hacker?                @relation("SmsPreferenceEventHacker", fields: [hackerId], references: [id])
  hackerId    String?
  receivedAt  DateTime               @default(now())

  @@index([fromNumber, receivedAt])
  @@index([hackerId, receivedAt])
}

model EventStaffAudit {
  id            String                @id @default(uuid())
  event         Event                 @relation(fields: [eventId], references: [id])
  eventId       String
  staffHacker   Hacker                @relation("EventStaffAuditSubject", fields: [staffHackerId], references: [id])
  staffHackerId String
  actor         Hacker                @relation("EventStaffAuditActor", fields: [actorId], references: [id])
  actorId       String
  action        EventStaffAuditAction
  fromRole      EventStaffRole?
  toRole        EventStaffRole?
  createdAt     DateTime              @default(now())

  @@index([eventId, createdAt])
  @@index([staffHackerId, createdAt])
  @@index([actorId, createdAt])
}

model UserBan {
  id               String    @id @default(uuid())
  hacker           Hacker    @relation("UserBanHacker", fields: [hackerId], references: [id])
  hackerId         String
  publicSafeReason String
  internalNote     String?
  createdBy        Hacker    @relation("UserBanCreator", fields: [createdById], references: [id])
  createdById      String
  createdAt        DateTime  @default(now())
  revokedBy        Hacker?   @relation("UserBanRevoker", fields: [revokedById], references: [id])
  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?

  @@index([hackerId, revokedAt])
  @@index([createdById])
}

model UserBanFlag {
  id             String        @id @default(uuid())
  chapter        Chapter       @relation(fields: [chapterId], references: [id])
  chapterId      String
  hacker         Hacker        @relation("UserBanFlagHacker", fields: [hackerId], references: [id])
  hackerId       String
  createdBy      Hacker        @relation("UserBanFlagCreator", fields: [createdById], references: [id])
  createdById    String
  reason         String
  status         BanFlagStatus @default(OPEN)
  resolutionNote String?
  resolvedBy     Hacker?       @relation("UserBanFlagResolver", fields: [resolvedById], references: [id])
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([chapterId, status])
  @@index([hackerId, status])
  @@index([createdById])
}

model HackerOrganizerNote {
  id          String                        @id @default(uuid())
  hacker      Hacker                        @relation("OrganizerNoteHacker", fields: [hackerId], references: [id])
  hackerId    String                        @unique
  body        String
  updatedBy   Hacker                        @relation("OrganizerNoteUpdater", fields: [updatedById], references: [id])
  updatedById String
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  revisions   HackerOrganizerNoteRevision[]

  @@index([updatedById])
}

model HackerOrganizerNoteRevision {
  id         String              @id @default(uuid())
  note       HackerOrganizerNote @relation(fields: [noteId], references: [id])
  noteId     String
  hacker     Hacker              @relation("OrganizerNoteRevisionHacker", fields: [hackerId], references: [id])
  hackerId   String
  editedBy   Hacker              @relation("OrganizerNoteRevisionEditor", fields: [editedById], references: [id])
  editedById String
  patchText  String
  createdAt  DateTime            @default(now())

  @@index([noteId, createdAt])
  @@index([hackerId, createdAt])
  @@index([editedById])
}

model PitchProject {
  id             String             @id @default(uuid())
  pitchSession   PitchSession       @relation(fields: [pitchSessionId], references: [id])
  pitchSessionId String
  project        Project            @relation(fields: [projectId], references: [id])
  projectId      String
  addedBy        Hacker             @relation(fields: [addedById], references: [id])
  addedById      String
  position       Int                @default(0)
  status         PitchProjectStatus @default(QUEUED)
  approved       Boolean            @default(false)
  isTopProject   Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  // Timer fields
  timerPhase     PitchTimerPhase    @default(WAITING)
  timerStartedAt DateTime?
  completedAt    DateTime?
  allottedSec    Int?
  pitchVotes     PitchProjectVote[]

  @@unique([pitchSessionId, projectId])
  @@index([pitchSessionId, position])
  @@index([status])
}

model PitchProjectVote {
  id             String                @id @default(uuid())
  pitchProject   PitchProject          @relation(fields: [pitchProjectId], references: [id])
  pitchProjectId String
  hacker         Hacker                @relation(fields: [hackerId], references: [id])
  hackerId       String
  value          PitchProjectVoteValue
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @default(now()) @updatedAt

  @@unique([pitchProjectId, hackerId])
  @@index([pitchProjectId])
  @@index([hackerId])
}

enum PitchProjectVoteValue {
  LIKE
  DISLIKE
}

enum PitchProjectStatus {
  QUEUED
  APPROVED
  CURRENT
  DONE
  SKIPPED
}

enum PitchTimerPhase {
  WAITING
  RUNNING
  COMPLETED
}

model WeeklyEmail {
  id           String               @id @default(uuid())
  subject      String               @db.VarChar(200)
  body         String
  status       WeeklyEmailStatus    @default(DRAFT)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  emailBatches EmailDeliveryBatch[]

  @@index([status, updatedAt])
}

enum WeeklyEmailStatus {
  DRAFT
  SENDING
  SENT
}

model EmailDeliveryBatch {
  id                   String                   @id @default(uuid())
  eventCommunicationId String?
  eventCommunication   EventCommunication?      @relation(fields: [eventCommunicationId], references: [id])
  weeklyEmailId        String?
  weeklyEmail          WeeklyEmail?             @relation(fields: [weeklyEmailId], references: [id])
  messages             Json
  status               EmailDeliveryBatchStatus @default(QUEUED)
  claimToken           String?
  claimedAt            DateTime?
  publishedAt          DateTime?
  completedAt          DateTime?
  outcomes             Json?
  sentCount            Int                      @default(0)
  failedCount          Int                      @default(0)
  createdAt            DateTime                 @default(now())

  @@index([eventCommunicationId, status])
  @@index([weeklyEmailId, status])
  @@index([status, publishedAt])
}

enum EmailDeliveryBatchStatus {
  QUEUED
  PROCESSING
  COMPLETED
}

// A shared rate limit across function instances and deployments.
model EmailDeliveryRateLimit {
  region          String   @id
  nextAvailableAt DateTime @default(now())
}

// Judging

model JudgingTrack {
  id            String              @id @default(uuid())
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  name          String
  description   String?
  position      Int                 @default(0)
  // [{ id, prompt, required }]; answers are keyed by question id.
  questionsJson Json                @default("[]")
  criteria      JudgingCriterion[]
  judges        EventJudgeTrack[]
  submissions   JudgingSubmission[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([eventId, position])
}

// A criterion without a track applies to every track in the event.
model JudgingCriterion {
  id          String               @id @default(uuid())
  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  track       JudgingTrack?        @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId     String?
  name        String
  description String?
  weight      Float                @default(1)
  position    Int                  @default(0)
  scores      JudgingReviewScore[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([eventId, trackId, position])
}

model EventJudge {
  id          String            @id @default(uuid())
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String
  email       String
  name        String?
  hacker      Hacker?           @relation("EventJudgeHacker", fields: [hackerId], references: [id])
  hackerId    String?
  // SHA-256 of the magic-link token; the raw token only lives in the email and cookie.
  tokenHash   String            @unique
  invitedBy   Hacker            @relation("EventJudgeInviter", fields: [invitedById], references: [id])
  invitedById String
  invitedAt   DateTime          @default(now())
  lastSentAt  DateTime?
  lastSeenAt  DateTime?
  // Revoking keeps the judge's reviews but invalidates their link and access.
  revokedAt   DateTime?
  tracks      EventJudgeTrack[]
  reviews     JudgingReview[]
  assignments JudgingAssignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([eventId, email])
  @@index([hackerId])
}

model EventJudgeTrack {
  judge   EventJudge   @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  judgeId String
  track   JudgingTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  trackId String

  @@id([judgeId, trackId])
  @@index([trackId])
}

model JudgingSubmission {
  id            String          @id @default(uuid())
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  track         JudgingTrack    @relation(fields: [trackId], references: [id])
  trackId       String
  // { [questionId]: answer, additionalInfo: string }
  answersJson   Json
  submittedBy   Hacker          @relation("JudgingSubmissionSubmitter", fields: [submittedById], references: [id])
  submittedById String
  reviews       JudgingReview[]
  assignments   JudgingAssignment[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([eventId, projectId])
  @@index([trackId])
}

model JudgingAssignment {
  judge        EventJudge        @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  judgeId      String
  submission   JudgingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  @@id([judgeId, submissionId])
  @@index([submissionId])
}

model JudgingReview {
  id           String               @id @default(uuid())
  judge        EventJudge           @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  judgeId      String
  submission   JudgingSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  comment      String?
  scores       JudgingReviewScore[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([judgeId, submissionId])
  @@index([submissionId])
}

model JudgingReviewScore {
  review      JudgingReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reviewId    String
  criterion   JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  criterionId String
  score       Int

  @@id([reviewId, criterionId])
  @@index([criterionId])
}
